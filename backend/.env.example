# ---------------------------------------------------------------------------
# Backend environment variables.
# Copy this file to ".env" and fill in real values before running the server.
# ---------------------------------------------------------------------------

# HTTP port the Express server listens on.
PORT=5000

# Node environment: "development" | "production". Vercel sets this to
# "production" automatically; do not rely on development defaults in Vercel.
NODE_ENV=development

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/ems
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/ems
MONGO_URI=mongodb://127.0.0.1:27017/ems

# Secret used to sign JWT access tokens.
# Must be at least 32 characters in production — the server refuses to serve
# requests with a short or placeholder secret, because a guessable secret means
# every token can be forged. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_this_to_a_long_random_secret
# Access-token lifetime (e.g. 15m, 1h, 7d).
JWT_EXPIRES_IN=1d

# Origin(s) allowed to call the API (the frontend URL). Used by CORS.
# Comma-separate to allow several, e.g. a preview deployment and production:
#   CLIENT_ORIGIN=https://ems.example.com,https://ems-preview.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Credentials for the auto-created Super Admin (used by "npm run seed").
# Change SEED_ADMIN_PASSWORD before deploying: production start-up fails if it
# is still the documented default below.
SEED_ADMIN_EMAIL=admin@ems.com
SEED_ADMIN_PASSWORD=Admin@123
