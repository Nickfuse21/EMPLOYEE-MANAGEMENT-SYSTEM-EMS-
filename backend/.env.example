# ---------------------------------------------------------------------------
# Backend environment variables.
# Copy this file to ".env" and fill in real values before running the server.
# ---------------------------------------------------------------------------

# HTTP port the Express server listens on.
PORT=5000

# Node environment: "development" | "production".
NODE_ENV=development

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/ems
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/ems
MONGO_URI=mongodb://127.0.0.1:27017/ems

# Secret used to sign JWT access tokens. Use a long, random string in production.
JWT_SECRET=change_this_to_a_long_random_secret
# Access-token lifetime (e.g. 15m, 1h, 7d).
JWT_EXPIRES_IN=1d

# Origin allowed to call the API (the frontend URL). Used by CORS.
CLIENT_ORIGIN=http://localhost:5173

# Credentials for the auto-created Super Admin (used by "npm run seed").
SEED_ADMIN_EMAIL=admin@ems.com
SEED_ADMIN_PASSWORD=Admin@123
