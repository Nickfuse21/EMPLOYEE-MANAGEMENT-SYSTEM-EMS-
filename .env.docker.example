# ---------------------------------------------------------------------------
# Secrets for `docker compose up`. Copy to `.env` and fill in real values:
#
#   cp .env.docker.example .env
#
# `.env` is git-ignored. Compose refuses to start if the required values below
# are missing, which is deliberate — a stack that boots with a placeholder JWT
# secret is worse than one that refuses to boot.
# ---------------------------------------------------------------------------

# --- Database credentials --------------------------------------------------
MONGO_USER=ems_app
MONGO_PASSWORD=replace-with-a-long-random-password

# --- Application secrets ---------------------------------------------------
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1d

# --- First admin account ---------------------------------------------------
# Created by `npm run seed`. Change the password immediately after first login —
# the API rejects the documented default in production.
SEED_ADMIN_EMAIL=admin@ems.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# --- CORS ------------------------------------------------------------------
# Comma-separate several origins if you have more than one frontend host.
CLIENT_ORIGIN=http://localhost:8080
